# Конфигурация сервера Polaris. Скопируй в `.env` и подставь значения.
# .env в git НЕ коммитится (см. .gitignore). Секретов в коде нет — только здесь.

# Порт HTTP-сервера
PORT=8787

# Ключ бесплатной Groq для наставника Cosmo. Получить: https://console.groq.com/keys
# Без ключа рыночные данные работают, а Cosmo отвечает 503 («нет связи»).
GROQ_API_KEY=

# (необязательно) Переопределить модель Groq. По умолчанию llama-3.3-70b-versatile.
GROQ_MODEL=
